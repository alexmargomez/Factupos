# ==========================================
# Variables de Entorno - Docker Compose (Raíz)
# ==========================================

# Puertos (Host y Contenedores)
BACKEND_PORT=7000
FRONTEND_PORT=5173
DB_EXTERNAL_PORT=3307

# Base de Datos (MariaDB)
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=factupos
DB_USERNAME=factupos_user
DB_PASSWORD=factupos_pass
DB_ROOT_PASSWORD=root_factupos_pass

# Backend (Laravel API)
APP_NAME="Factupos"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:7000
PHP_CLI_SERVER_WORKERS=4

# Frontend (React + Vite)
VITE_API_URL=/api
VITE_BACKEND_PROXY=http://backend:7000
